# ==============================================================================
# Shivkrupa Frontend — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in shivkrupa-frontend/
#    cp .env.example shivkrupa-frontend/.env
# 2. Fill in your Supabase project credentials from https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public API Key (safe to use in frontend client)
VITE_SUPABASE_ANON_KEY=your-actual-supabase-anon-key

# Optional Backend API URL for other microservices
VITE_API_BASE_URL=http://localhost:5000/api
